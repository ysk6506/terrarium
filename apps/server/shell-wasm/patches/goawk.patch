--- a/interp/hook.go
+++ b/interp/hook.go
@@ -0,0 +1,62 @@
+package interp
+
+import (
+	"bytes"
+	"io"
+)
+
+// ShellHook, when set, runs the command of system(), `cmd | getline` and `print | cmd` instead of os/exec (which
+// does not exist on WASI). It returns the exit status. (Terrarium experiment patch.)
+var ShellHook func(code string, stdin io.Reader, stdout, stderr io.Writer) int
+
+// outHookStream collects what is printed to `print | cmd` and runs the command when the stream is closed.
+type outHookStream struct {
+	p        *interp
+	code     string
+	buf      bytes.Buffer
+	exitCode int
+	closed   bool
+}
+
+func (s *outHookStream) Write(b []byte) (int, error) { return s.buf.Write(b) }
+func (s *outHookStream) Flush() error                { return nil }
+func (s *outHookStream) Close() error {
+	if s.closed {
+		return errDoubleClose
+	}
+	s.closed = true
+	s.p.flushOutputAndError()
+	s.exitCode = ShellHook(s.code, &s.buf, s.p.output, s.p.errorOutput)
+	return nil
+}
+func (s *outHookStream) ExitCode() int { return s.exitCode }
+
+// inHookStream serves the output of `cmd | getline`, run when the stream was opened.
+type inHookStream struct {
+	io.Reader
+	exitCode int
+	status   int
+	closed   bool
+}
+
+func (s *inHookStream) Close() error {
+	if s.closed {
+		return errDoubleClose
+	}
+	s.closed = true
+	s.exitCode = s.status
+	return nil
+}
+func (s *inHookStream) ExitCode() int { return s.exitCode }
+
+// StepHook, when set, is called once for every backward jump (every turn of a loop), every iteration of `for (k in a)`,
+// every user function call and every input record. A non-nil error stops the program with that error. The host counts
+// steps with it, so that a loop which never ends is stopped at the same turn on every machine. (Terrarium patch.)
+var StepHook func() error
+
+func step() error {
+	if StepHook != nil {
+		return StepHook()
+	}
+	return nil
+}
