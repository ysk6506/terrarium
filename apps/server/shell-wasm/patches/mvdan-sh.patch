@@ -0,0 +1,27 @@
+// Terrarium patch: hooks for the embedding host (the simulation counts what a line does and orders its background jobs).
+
+package interp
+
+import (
+	"context"
+	"sync"
+)
+
+// StepHook, when set, is called before every statement the interpreter runs, wherever it runs (loops, functions,
+// background jobs). A non-nil error stops the shell with that error as a fatal one. The host counts steps with it, so
+// that a line which never ends is stopped at the same statement on every machine.
+var StepHook func() error
+
+type bgJobKey struct{}
+
+var bgRunning sync.WaitGroup
+
+// BgWait blocks until every background job has finished (they run in the order they were started; see stmt).
+func BgWait() { bgRunning.Wait() }
+
+// BgJob returns the number of the background job the context belongs to (1, 2, ... in the order they were started by
+// its shell), or 0 for the foreground. The host charges `sleep` to the job that called it.
+func BgJob(ctx context.Context) int {
+	n, _ := ctx.Value(bgJobKey{}).(int)
+	return n
+}
