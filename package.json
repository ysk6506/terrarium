{
  "name": "terrarium",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @terrarium/server --filter @terrarium/web dev",
    "build": "pnpm --filter @terrarium/web build",
    "start": "pnpm --filter @terrarium/server start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "structure": "tsx harness/src/run-all.ts --with-coverage && tsx harness/src/ux/run.ts check",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm structure",
    "check:pr": "pnpm lint && pnpm typecheck && pnpm test && tsx harness/src/run-all.ts --with-coverage --base origin/main && tsx harness/src/ux/run.ts check --base origin/main",
    "ux": "tsx harness/src/ux/run.ts",
    "ratchet": "tsx harness/src/checks/coverage.ts ratchet && tsx harness/src/checks/debt.ts ratchet",
    "lock-tests": "tsx harness/src/checks/testguard.ts lock",
    "moss-eval": "tsx tests/spec/moss-eval.ts",
    "moss-bank": "tsx tests/spec/moss-bank.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.2.7",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-check": "4.10.2",
    "playwright": "1.63.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.8.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
